    "express-validator": "^7.2.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.7.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.5",
    "nodemon": "^3.1.10",
    "supertest": "^7.3.1",
    "testcontainers": "11.7.2",
    "ts-node": "^10.9.2",
