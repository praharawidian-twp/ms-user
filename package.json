{
  "name": "user-service",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "",
  "main": "src/server.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "TESTCONTAINERS_RYUK_DISABLED=true vitest run --config vitest.integration.config.mts",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "db:studio": "npx drizzle-kit studio",
    "db:migrate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit migrate",
    "dev": "nodemon ./src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.5",
